+using System.Security.Claims;
+using Duende.IdentityServer.Models;
+using eShop.Identity.API.Models;
+using eShop.Identity.API.Services;
+using Microsoft.AspNetCore.Identity;
+
+namespace eShop.Application.UnitTests;
+
+[TestClass]
+public class ProfileServiceTests
+{
+    private static ApplicationUser CreateUserWithPaymentCardData()
+    {
+        return new ApplicationUser
+        {
+            Id = "1",
+            UserName = "alice@example.com",
+            Name = "Alice",
+            LastName = "Smith",
+            CardNumber = "XXXXXXXXXXXX1881",
+            CardHolderName = "Alice Smith",
+            SecurityNumber = "123",
+            Expiration = "12/24",
+            City = "Redmond",
+            Country = "U.S.",
+            State = "WA",
+            Street = "15703 NE 61st Ct",
+            ZipCode = "98052"
+        };
+    }
+
+    private static ProfileService CreateProfileService(ApplicationUser user)
+    {
+        var userStore = Substitute.For<IUserStore<ApplicationUser>>();
+        userStore.FindByIdAsync(user.Id, Arg.Any<CancellationToken>()).Returns(user);
+
+        return new ProfileService(new UserManager<ApplicationUser>(
+            userStore, null, null, null, null, null, null, null, null));
+    }
+
+    [TestMethod]
+    public async Task GetProfileDataAsyncNeverIssuesPaymentCardClaims()
+    {
+        var profileService = CreateProfileService(CreateUserWithPaymentCardData());
+        var context = new ProfileDataRequestContext
+        {
+            Subject = new ClaimsPrincipal(new ClaimsIdentity(new[] { new Claim("sub", "1") }, "Test")),
+            RequestedClaimTypes = null
+        };
+
+        await profileService.GetProfileDataAsync(context);
+
+        Assert.IsNotNull(context.IssuedClaims);
+        Assert.IsTrue(context.IssuedClaims.Any(claim => claim.Type == "name"));
+        Assert.IsFalse(context.IssuedClaims.Any(claim => claim.Type.StartsWith("card_", StringComparison.OrdinalIgnoreCase)));
+    }
+
+    [TestMethod]
+    public async Task GetProfileDataAsyncFiltersIssuedClaimsToRequestedClaimTypes()
+    {
+        var profileService = CreateProfileService(CreateUserWithPaymentCardData());
+        var context = new ProfileDataRequestContext
+        {
+            Subject = new ClaimsPrincipal(new ClaimsIdentity(new[] { new Claim("sub", "1") }, "Test")),
+            RequestedClaimTypes = new[] { "name", "address_city" }
+        };
+
+        await profileService.GetProfileDataAsync(context);
+
+        Assert.IsNotNull(context.IssuedClaims);
+        CollectionAssert.AreEquivalent(
+            new[] { "name", "address_city" },
+            context.IssuedClaims.Select(claim => claim.Type).ToArray());
+    }
+}
