+    private static bool IsAllowedImageUrl(string url)
+    {
+        // Only the app's own product-image proxy may be loaded as an <img>. Any absolute URL
+        // (any scheme or host), protocol-relative URL, or other path is downgraded to escaped
+        // text so a message can't make the browser fetch attacker-chosen content or leak data
+        // (e.g. PII echoed into a query string) to a remote origin.
+        url = url.Trim();
+
+        // Keep the path pinned to the proxy: ".." would let "/product-images/../.."
+        // normalize to some other path on the same origin.
+        if (url.Contains(".."))
+        {
+            return false;
+        }
+
+        return url.StartsWith("/product-images/", StringComparison.OrdinalIgnoreCase)
+            || url.StartsWith("product-images/", StringComparison.OrdinalIgnoreCase);
+    }
+
