+namespace eShop.Ordering.UnitTests.Application;
+
+[TestClass]
+public class CreateOrderCommandTest
+{
+    [TestMethod]
+    public void Create_Order_Command_ToString_Check_No_Card_Data()
+    {
+        // Arrange - upstream masks the card number (OrdersApi), the security number stays raw,
+        // so neither value may ever be reachable through ToString() ({@Command} log sinks).
+        var command = new CreateOrderCommand(
+            new List<BasketItem>(), "user-id-1", "johndoe", "City", "Street", "State", "Country", "ZipCode",
+            "4111111111111111", "CARD HOLDER", DateTime.MaxValue, "456", 1);
+
+        // Act
+        var rendered = command.ToString();
+
+        //Assert - only the command identity is rendered, never the payment data
+        Assert.IsTrue(rendered.Contains("user-id-1"));
+        Assert.IsFalse(rendered.Contains("4111"), "CardNumber must not be rendered");
+        Assert.IsFalse(rendered.Contains("456"), "CardSecurityNumber must not be rendered");
+        Assert.IsFalse(rendered.Contains("CARD HOLDER"), "CardHolderName must not be rendered");
+        Assert.IsFalse(rendered.Contains("9999"), "CardExpiration must not be rendered");
+    }
+}
