+    public async Task SendAll(IEnumerable<WebhookSubscription> receivers, WebhookData data)
+    {
+        var client = httpClientFactory.CreateClient(WebhooksSenderClientName);
+        var json = JsonSerializer.Serialize(data);
+        var tasks = receivers.Select(r => OnSendData(r, json, client));
+        await Task.WhenAll(tasks);
+    }
+
+    private async Task OnSendData(WebhookSubscription subs, string jsonData, HttpClient client)
+    {
+        if (!Uri.TryCreate(subs.DestUrl, UriKind.Absolute, out var destination) || !await IsValidDeliveryTarget(destination))
+        {
+            logger.LogWarning("Skipping hook to {DestUrl} of type {Type} because the destination is not a valid delivery target", subs.DestUrl, subs.Type);
+            return;
+        }
+
+        var request = new HttpRequestMessage()
+        {
+            RequestUri = destination,
+            Method = HttpMethod.Post,
+            Content = new StringContent(jsonData, Encoding.UTF8, "application/json")
+        };
+
+        if (!string.IsNullOrWhiteSpace(subs.Token))
+        {
+            request.Headers.Add("X-eshop-whtoken", subs.Token);
+        }
+
+        if (logger.IsEnabled(LogLevel.Debug))
+        {
+            logger.LogDebug("Sending hook to {DestUrl} of type {Type}", subs.DestUrl, subs.Type);
+        }
+
+        await client.SendAsync(request);
+    }
+
+    private async Task<bool> IsValidDeliveryTarget(Uri destination)
+    {
+        if (destination.Scheme is not ("http" or "https"))
+        {
+            logger.LogWarning("Delivery to {DestUrl} refused because only http and https destinations are allowed", destination);
+            return false;
+        }
+
+        IPAddress[] addresses;
+        try
+        {
+            addresses = await Dns.GetHostAddressesAsync(destination.IdnHost);
+        }
+        catch (Exception ex)
+        {
+            logger.LogWarning("Delivery to {DestUrl} refused because its host could not be resolved: {ExceptionType}", destination, ex.GetType().Name);
+            return false;
+        }
+
+        if (addresses.Any(IsDisallowedAddress))
+        {
+            logger.LogWarning("Delivery to {DestUrl} refused because its host resolves to a disallowed address", destination);
+            return false;
+        }
+
+        return true;
+    }
+
+    private static bool IsDisallowedAddress(IPAddress address)
+    {
+        if (address.IsIPv4MappedToIPv6)
+        {
+            address = address.MapToIPv4();
+        }
+
+        if (IPAddress.IsLoopback(address) || address.IsIPv6LinkLocal || address.IsIPv6Multicast)
+        {
+            return true;
+        }
+
+        var octets = address.GetAddressBytes();
+
+        if (address.AddressFamily == AddressFamily.InterNetwork)
+        {
+            return octets[0] switch
+            {
+                0 => true,                                     // 0.0.0.0/8 "this network"
+                10 => true,                                    // 10.0.0.0/8 private
+                127 => true,                                   // 127.0.0.0/8 loopback
+                100 when octets[1] >= 64 => true,              // 100.64.0.0/10 shared address space
+                169 when octets[1] == 254 => true,             // 169.254.0.0/16 link-local incl. cloud metadata
+                172 when octets[1] is >= 16 and <= 31 => true, // 172.16.0.0/12 private
+                192 when octets[1] == 168 => true,             // 192.168.0.0/16 private
+                >= 224 => true,                                // multicast and reserved ranges
+                _ => false,
+            };
+        }
+
+        return octets[0] switch
+        {
+            0 => true,                           // :: unspecified
+            0xFC or 0xFD => true,                // fc00::/7 unique local
+            0xFE when octets[1] >= 0xC0 => true, // fec0::/10 deprecated site-local
+            _ => false,
+        };
+    }
 
