+using eShop.Ordering.Domain.AggregatesModel.OrderAggregate;
+
+namespace eShop.Ordering.UnitTests.Application;
+
+[TestClass]
+public class CancelOrderCommandHandlerTest
+{
+    [TestMethod]
+    public async Task Handle_rejects_cancelling_order_owned_by_another_user()
+    {
+        // Arrange
+        var order = FakeOrder();
+        order.SetPaymentMethodVerified(99, 1);
+
+        var orderRepositoryMock = Substitute.For<IOrderRepository>();
+        orderRepositoryMock.GetAsync(Arg.Any<int>())
+            .Returns(order);
+
+        var buyerRepositoryMock = Substitute.For<IBuyerRepository>();
+        buyerRepositoryMock.FindAsync(Arg.Any<string>())
+            .Returns(new Buyer("attacker-identity", "attacker"));
+
+        var identityServiceMock = Substitute.For<IIdentityService>();
+        identityServiceMock.GetUserIdentity().Returns("attacker-identity");
+
+        var handler = new CancelOrderCommandHandler(orderRepositoryMock, buyerRepositoryMock, identityServiceMock);
+
+        // Act
+        var result = await handler.Handle(new CancelOrderCommand(order.Id), new CancellationToken());
+
+        //Assert
+        Assert.IsFalse(result);
+        Assert.AreEqual(OrderStatus.Submitted, order.OrderStatus);
+    }
+
+    private Order FakeOrder()
+    {
+        return new Order("1", "victim", new Address("street", "city", "state", "country", "zipcode"), 1, "12", "111", "victim", DateTime.UtcNow.AddYears(1));
+    }
+}
