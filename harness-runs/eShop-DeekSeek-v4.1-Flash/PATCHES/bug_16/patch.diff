@@ -0,0 +1,43 @@
+using ClientApp.UnitTests.Mocks;
+using eShop.ClientApp.Models.Token;
+using eShop.ClientApp.Services.Identity;
+using IdentityModel.OidcClient;
+
+namespace ClientApp.UnitTests.Services;
+
+[TestClass]
+public class IdentityServiceTests
+{
+    [TestMethod]
+    public async Task SignOutClearsStoredTokenWhenProviderLogoutFailsTest()
+    {
+        var settingsService = new MockSettingsService();
+        await settingsService.SetUserTokenAsync(new UserToken
+        {
+            AccessToken = "access-token",
+            IdToken = "id-token",
+            RefreshToken = "refresh-token",
+            ExpiresAt = DateTimeOffset.Now.AddHours(1)
+        });
+
+        var identityService = new FailingLogoutIdentityService(settingsService);
+
+        var signedOut = await identityService.SignOutAsync();
+
+        Assert.IsFalse(signedOut);
+        Assert.IsNull(await settingsService.GetUserTokenAsync());
+    }
+
+    private sealed class FailingLogoutIdentityService : IdentityService
+    {
+        public FailingLogoutIdentityService(ISettingsService settingsService)
+            : base(null!, settingsService, null!)
+        {
+        }
+
+        protected override Task<LogoutResult> LogoutWithProviderAsync()
+        {
+            throw new InvalidOperationException("Identity provider is unavailable.");
+        }
+    }
+}
