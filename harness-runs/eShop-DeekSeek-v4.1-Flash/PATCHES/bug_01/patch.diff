+    public async Task CatalogWriteEndpointsRejectAnonymousRequests()
+    {
+        var httpClient = CreateHttpClient(new ApiVersion(2.0));
+        httpClient.DefaultRequestHeaders.Add(AutoAuthorizeMiddleware.AnonymousHeader, "true");
+
+        var putResponse = await httpClient.PutAsJsonAsync(
+            $"/api/catalog/items/{int.MaxValue}",
+            new CatalogItem("Anonymous update"),
+            TestContext.Current.CancellationToken);
+        var postResponse = await httpClient.PostAsync(
+            "/api/catalog/items",
+            new StringContent(string.Empty),
+            TestContext.Current.CancellationToken);
+        var deleteResponse = await httpClient.DeleteAsync(
+            $"/api/catalog/items/{int.MaxValue}",
+            TestContext.Current.CancellationToken);
+
+        Assert.Equal(HttpStatusCode.Unauthorized, putResponse.StatusCode);
+        Assert.Equal(HttpStatusCode.Unauthorized, postResponse.StatusCode);
+        Assert.Equal(HttpStatusCode.Unauthorized, deleteResponse.StatusCode);
+    }
