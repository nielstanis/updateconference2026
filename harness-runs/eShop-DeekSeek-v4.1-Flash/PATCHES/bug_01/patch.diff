+using System.Security.Claims;
+
+using Microsoft.AspNetCore.Http;
+
+namespace eShop.Catalog.FunctionalTests;
+
+// Populates an authenticated user so the existing happy-path write tests keep working.
+// Requests that set AnonymousHeader are left anonymous so the authorization regression
+// test exercises the real authorization pipeline.
+internal sealed class AutoAuthorizeMiddleware
+{
+    public const string AnonymousHeader = "X-Test-Anonymous";
+
+    private readonly RequestDelegate _next;
+
+    public AutoAuthorizeMiddleware(RequestDelegate next)
+    {
+        _next = next;
+    }
+
+    public async Task Invoke(HttpContext httpContext)
+    {
+        if (!httpContext.Request.Headers.ContainsKey(AnonymousHeader))
+        {
+            var identity = new ClaimsIdentity("test");
+            identity.AddClaim(new Claim(ClaimTypes.Name, "9e3163b9-1ae6-4652-9dc6-7898ab7b7a00"));
+            httpContext.User.AddIdentity(identity);
+        }
+
+        await _next(httpContext);
+    }
+}
