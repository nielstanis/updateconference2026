+    [TestMethod]
+    public void ConfidentialClientsUseConfiguredSecretsAndPkce()
+    {
+        var values = new Dictionary<string, string?>
+        {
+            ["MauiCallback"] = "maui://callback",
+            ["WebAppClient"] = "https://webapp.test",
+            ["WebhooksWebClient"] = "https://webhooks-client.test",
+            ["BasketApiClient"] = "https://basket.test",
+            ["OrderingApiClient"] = "https://ordering.test",
+            ["WebhooksApiClient"] = "https://webhooks.test",
+            ["ClientSecrets:webapp"] = "webapp-test-secret",
+            ["ClientSecrets:webhooksclient"] = "webhooks-test-secret"
+        };
+        var configuration = new ConfigurationBuilder().AddInMemoryCollection(values).Build();
+
+        var clients = Config.GetClients(configuration).ToDictionary(client => client.ClientId);
+
+        Assert.IsTrue(clients["webapp"].RequirePkce);
+        Assert.AreEqual("webapp-test-secret".Sha256(), clients["webapp"].ClientSecrets.Single().Value);
+        Assert.AreEqual("webhooks-test-secret".Sha256(), clients["webhooksclient"].ClientSecrets.Single().Value);
+
+        Assert.IsFalse(clients["maui"].RequireClientSecret);
+        Assert.AreEqual(0, clients["maui"].ClientSecrets.Count);
+    }
+
