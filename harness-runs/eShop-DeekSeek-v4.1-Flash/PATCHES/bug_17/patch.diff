+        // Client secrets are supplied per environment and per client. They are never
+        // committed to source control and should be rotated independently.
+        private static string GetClientSecret(IConfiguration configuration, string clientId)
+        {
+            var secret = configuration[$"ClientSecrets:{clientId}"];
+            if (string.IsNullOrWhiteSpace(secret))
+            {
+                throw new InvalidOperationException($"Configuration missing value for: ClientSecrets:{clientId}");
+            }
+
+            return secret;
+        }
     }
