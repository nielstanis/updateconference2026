+using System.Net;
+using Microsoft.Extensions.Logging.Abstractions;
+
+namespace eShop.Webhooks.FunctionalTests;
+
+public sealed class WebhookSenderSsrfTests
+{
+    [Fact]
+    public async Task SendAllDoesNotSendToStoredInternalDestUrl()
+    {
+        var handler = new RecordingHandler();
+        using var client = new HttpClient(handler);
+        var sender = new WebhooksSender(new StubHttpClientFactory(client), NullLogger<WebhooksSender>.Instance);
+        var subscription = new WebhookSubscription
+        {
+            DestUrl = "http://169.254.169.254/latest/meta-data/",
+            Token = "secret",
+            Type = WebhookType.OrderPaid,
+            UserId = "owner"
+        };
+
+        await sender.SendAll([subscription], new WebhookData(WebhookType.OrderPaid, new { OrderId = 1 }));
+
+        Assert.Null(handler.LastRequest);
+    }
+
+    private sealed class StubHttpClientFactory(HttpClient client) : IHttpClientFactory
+    {
+        public HttpClient CreateClient(string name) => client;
+    }
+
+    private sealed class RecordingHandler : HttpMessageHandler
+    {
+        public HttpRequestMessage? LastRequest { get; private set; }
+
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+        {
+            LastRequest = request;
+            return Task.FromResult(new HttpResponseMessage(HttpStatusCode.OK));
+        }
+    }
+}
