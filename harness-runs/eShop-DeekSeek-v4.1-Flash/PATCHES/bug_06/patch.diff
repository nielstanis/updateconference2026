+using eShop.ServiceDefaults;
+using Microsoft.AspNetCore.Authentication.JwtBearer;
+using Microsoft.AspNetCore.Builder;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Options;
+
+namespace eShop.Application.UnitTests;
+
+[TestClass]
+public class AuthenticationExtensionsTests
+{
+    [TestMethod]
+    public void DefaultAuthenticationValidatesConfiguredAudience()
+    {
+        var builder = WebApplication.CreateBuilder();
+        builder.Configuration.AddInMemoryCollection(new Dictionary<string, string?>
+        {
+            ["Identity:Url"] = "https://identity.test",
+            ["Identity:Audience"] = "orders"
+        });
+
+        builder.AddDefaultAuthentication();
+
+        using var provider = builder.Services.BuildServiceProvider();
+        var jwt = provider.GetRequiredService<IOptionsMonitor<JwtBearerOptions>>()
+            .Get(JwtBearerDefaults.AuthenticationScheme);
+
+        Assert.IsTrue(jwt.TokenValidationParameters.ValidateAudience,
+            "Audience validation must stay enabled so tokens minted for other APIs are rejected.");
+        Assert.AreEqual("orders", jwt.TokenValidationParameters.ValidAudience);
+    }
+}
