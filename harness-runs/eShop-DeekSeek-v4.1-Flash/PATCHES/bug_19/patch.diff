+    [TestMethod]
+    public async Task WebhookEndpointDoesNotLogTokenValues()
+    {
+        var capture = new CapturingLoggerProvider();
+        var builder = WebApplication.CreateBuilder();
+        builder.WebHost.UseTestServer();
+        builder.Configuration["ValidateToken"] = "true";
+        builder.Configuration["WebhookClientOptions:Token"] = "expected-secret";
+        builder.Logging.AddProvider(capture);
+        builder.Services.AddSingleton<HooksRepository>();
+        await using var app = builder.Build();
+        app.MapWebhookEndpoints();
+        await app.StartAsync(TestContext.CancellationToken);
+        var client = app.GetTestClient();
+
+        using var request = new HttpRequestMessage(HttpMethod.Post, "/webhook-received")
+        {
+            Content = JsonContent.Create(new WebhookData { When = DateTime.UtcNow, Payload = "payload", Type = "OrderPaid" })
+        };
+        request.Headers.Add("X-eshop-whtoken", "caller-secret");
+        await client.SendAsync(request, TestContext.CancellationToken);
+
+        Assert.IsTrue(capture.Messages.Count > 0, "No log messages were captured");
+        var logged = string.Join(Environment.NewLine, capture.Messages);
+        Assert.IsFalse(logged.Contains("expected-secret"), logged);
+        Assert.IsFalse(logged.Contains("caller-secret"), logged);
+    }
+
+    private sealed class CapturingLoggerProvider : ILoggerProvider
+    {
+        public ConcurrentQueue<string> Messages { get; } = new();
+
+        public ILogger CreateLogger(string categoryName) => new CapturingLogger(Messages);
+
+        public void Dispose()
+        {
+        }
+
+        private sealed class CapturingLogger(ConcurrentQueue<string> messages) : ILogger
+        {
+            public IDisposable? BeginScope<TState>(TState state) where TState : notnull => null;
+
+            public bool IsEnabled(LogLevel logLevel) => true;
+
+            public void Log<TState>(LogLevel logLevel, EventId eventId, TState state, Exception? exception, Func<TState, Exception?, string> formatter)
+                => messages.Enqueue(formatter(state, exception));
+        }
+    }
