+namespace eShop.Ordering.API.Infrastructure.Services;
+
+public interface ICatalogPriceService
+{
+    // Returns the authoritative catalog price for each requested product.
+    // Products that are unknown to the catalog are omitted from the result.
+    Task<IReadOnlyDictionary<int, decimal>> GetPricesAsync(IEnumerable<int> productIds, CancellationToken cancellationToken);
+}
