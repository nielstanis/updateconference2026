+using System.Net.Http.Json;
+
+namespace eShop.Ordering.API.Infrastructure.Services;
+
+public class CatalogPriceService(HttpClient httpClient, ILogger<CatalogPriceService> logger) : ICatalogPriceService
+{
+    public async Task<IReadOnlyDictionary<int, decimal>> GetPricesAsync(IEnumerable<int> productIds, CancellationToken cancellationToken)
+    {
+        var ids = productIds.Distinct().ToArray();
+        if (ids.Length == 0)
+        {
+            return new Dictionary<int, decimal>();
+        }
+
+        // GET api/catalog/items/by?ids=1&ids=2&api-version=2.0 returns the current catalog entries.
+        var query = string.Join("&", ids.Select(id => $"ids={id}"));
+        var items = await httpClient.GetFromJsonAsync<List<CatalogItemPrice>>(
+            $"api/catalog/items/by?{query}&api-version=2.0", cancellationToken);
+
+        var prices = (items ?? new List<CatalogItemPrice>())
+            .GroupBy(item => item.Id)
+            .ToDictionary(group => group.Key, group => group.First().Price);
+
+        if (prices.Count != ids.Length)
+        {
+            logger.LogWarning("Catalog returned {ReturnedCount} of {RequestedCount} requested product prices", prices.Count, ids.Length);
+        }
+
+        return prices;
+    }
+
+    private sealed record CatalogItemPrice(int Id, decimal Price);
+}
