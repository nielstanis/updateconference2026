+    [TestMethod]
+    public async Task ReceivedMessagesDoesNotRenderTokensToAnonymousVisitors()
+    {
+        const string token = "super-secret-delivery-token";
+        var repository = new HooksRepository();
+        await repository.AddNew(new WebHookReceived
+        {
+            Data = "{\"orderId\":42}",
+            Token = token,
+            When = new DateTime(2026, 1, 1, 0, 0, 0, DateTimeKind.Utc)
+        });
+
+        var services = new ServiceCollection();
+        services.AddLogging();
+        services.AddAuthorization();
+        services.AddSingleton(repository);
+        await using var serviceProvider = services.BuildServiceProvider();
+        await using var renderer = new HtmlRenderer(serviceProvider, NullLoggerFactory.Instance);
+
+        var html = await renderer.Dispatcher.InvokeAsync(async () =>
+        {
+            var authenticationState = Task.FromResult(
+                new AuthenticationState(new ClaimsPrincipal(new ClaimsIdentity())));
+            var output = await renderer.RenderComponentAsync<CascadingValue<Task<AuthenticationState>>>(
+                ParameterView.FromDictionary(new Dictionary<string, object?>
+                {
+                    [nameof(CascadingValue<Task<AuthenticationState>>.Value)] = authenticationState,
+                    [nameof(CascadingValue<Task<AuthenticationState>>.ChildContent)] = (RenderFragment)(builder =>
+                    {
+                        builder.OpenComponent<ReceivedMessages>(0);
+                        builder.CloseComponent();
+                    })
+                }));
+
+            return output.ToHtmlString();
+        });
+
+        Assert.IsFalse(html.Contains(token, StringComparison.Ordinal), "The shared webhook delivery token must not be rendered to anonymous visitors.");
+        Assert.IsTrue(html.Contains("Log in to view received webhook messages", StringComparison.Ordinal));
+    }
 }
