+using System.Net;
+using System.Net.Sockets;
+
+namespace Webhooks.API.Services;
+
+/// <summary>
+/// Validates a user supplied webhook destination before it is used for an outbound request.
+/// Only public http(s) endpoints are accepted; loopback, private, link-local, metadata and
+/// platform resolved single-label hosts are rejected.
+/// </summary>
+public static class WebhookUrlValidator
+{
+    public static bool IsAllowed(string url) =>
+        Uri.TryCreate(url, UriKind.Absolute, out var uri) && IsAllowed(uri);
+
+    public static bool IsAllowed(Uri uri)
+    {
+        if (uri is null || !uri.IsAbsoluteUri)
+        {
+            return false;
+        }
+
+        if (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps)
+        {
+            return false;
+        }
+
+        // User info is not needed by a webhook receiver and is a common way to make a
+        // different host appear to be part of an otherwise valid URL.
+        if (!string.IsNullOrEmpty(uri.UserInfo))
+        {
+            return false;
+        }
+
+        var host = uri.DnsSafeHost.TrimEnd('.');
+        var addressCandidate = host.Trim('[', ']');
+
+        if (addressCandidate.Length == 0 ||
+            addressCandidate.Equals("localhost", StringComparison.OrdinalIgnoreCase) ||
+            addressCandidate.EndsWith(".localhost", StringComparison.OrdinalIgnoreCase) ||
+            addressCandidate.Equals("metadata.google.internal", StringComparison.OrdinalIgnoreCase))
+        {
+            return false;
+        }
+
+        if (IPAddress.TryParse(addressCandidate, out var address))
+        {
+            return IsPublicAddress(address);
+        }
+
+        // Reject numeric forms that system resolvers interpret as IPv4 (2130706433,
+        // 0x7f000001, 0177.0.0.1) but IPAddress.TryParse does not.
+        if (IsNumericHost(addressCandidate))
+        {
+            return false;
+        }
+
+        // Single-label names are resolved by the platform/service discovery and are never
+        // valid public webhook receivers.
+        return addressCandidate.Contains('.');
+    }
+
+    private static bool IsPublicAddress(IPAddress address)
+    {
+        if (address.IsIPv4MappedToIPv6)
+        {
+            address = address.MapToIPv4();
+        }
+
+        if (IPAddress.IsLoopback(address) ||
+            address.Equals(IPAddress.Any) ||
+            address.Equals(IPAddress.IPv6Any))
+        {
+            return false;
+        }
+
+        if (address.AddressFamily == AddressFamily.InterNetwork)
+        {
+            var bytes = address.GetAddressBytes();
+            return bytes[0] != 0 &&
+                   bytes[0] != 10 &&
+                   bytes[0] != 127 &&
+                   !(bytes[0] == 100 && bytes[1] >= 64 && bytes[1] <= 127) &&
+                   !(bytes[0] == 169 && bytes[1] == 254) &&
+                   !(bytes[0] == 172 && bytes[1] >= 16 && bytes[1] <= 31) &&
+                   !(bytes[0] == 192 && bytes[1] == 168) &&
+                   !(bytes[0] == 192 && bytes[1] == 0 && bytes[2] == 0) &&
+                   !(bytes[0] == 198 && (bytes[1] == 18 || bytes[1] == 19)) &&
+                   bytes[0] < 224;
+        }
+
+        if (address.AddressFamily == AddressFamily.InterNetworkV6)
+        {
+            return !address.IsIPv6LinkLocal &&
+                   !address.IsIPv6SiteLocal &&
+                   !address.IsIPv6UniqueLocal &&
+                   !address.IsIPv6Multicast;
+        }
+
+        return false;
+    }
+
+    private static bool IsNumericHost(string host) =>
+        host.Split('.').All(part =>
+            part.StartsWith("0x", StringComparison.OrdinalIgnoreCase)
+                ? part.Length > 2 && part[2..].All(char.IsAsciiHexDigit)
+                : part.Length > 0 && part.All(char.IsAsciiDigit));
+}
