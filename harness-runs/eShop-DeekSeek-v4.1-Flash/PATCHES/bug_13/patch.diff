+using Webhooks.API.Services;
+
+namespace eShop.Webhooks.FunctionalTests;
+
+public sealed class WebhookUrlValidatorTests
+{
+    [Theory]
+    [InlineData("https://receiver.test/webhook")]
+    [InlineData("http://8.8.8.8/webhook")]
+    public void PublicDestinationsAreAllowed(string url)
+    {
+        Assert.True(WebhookUrlValidator.IsAllowed(url));
+    }
+
+    [Theory]
+    [InlineData("http://127.0.0.1/admin")]
+    [InlineData("http://localhost:8080/admin")]
+    [InlineData("http://169.254.169.254/latest/meta-data/")]
+    [InlineData("http://[::1]/admin")]
+    [InlineData("http://10.0.0.5/internal")]
+    [InlineData("http://192.168.1.10/")]
+    [InlineData("http://192.0.0.192/")]
+    [InlineData("http://2130706433/")]
+    [InlineData("http://ordering-api/webhook")]
+    [InlineData("file:///etc/passwd")]
+    [InlineData("gopher://internal/")]
+    public void InternalOrUnsupportedDestinationsAreRejected(string url)
+    {
+        Assert.False(WebhookUrlValidator.IsAllowed(url));
+    }
+}
