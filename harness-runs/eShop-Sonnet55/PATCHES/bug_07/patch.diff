@@ -0,0 +1,20 @@
+using System.Net.Http.Json;
+
+namespace eShop.Ordering.API.Infrastructure.Services;
+
+public class CatalogPriceService(HttpClient httpClient) : ICatalogPriceService
+{
+    public async Task<IReadOnlyDictionary<int, CatalogPrice>> GetPricesAsync(IEnumerable<int> productIds, CancellationToken cancellationToken = default)
+    {
+        var ids = productIds.Distinct().ToList();
+        if (ids.Count == 0)
+        {
+            return new Dictionary<int, CatalogPrice>();
+        }
+
+        var uri = $"api/catalog/items/by?ids={string.Join("&ids=", ids)}";
+        var items = await httpClient.GetFromJsonAsync<List<CatalogPrice>>(uri, cancellationToken);
+
+        return (items ?? new List<CatalogPrice>()).ToDictionary(i => i.Id);
+    }
+}
