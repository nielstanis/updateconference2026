+using eShop.Ordering.Domain.AggregatesModel.OrderAggregate;
+
+namespace eShop.Ordering.UnitTests.Application;
+
+[TestClass]
+public class CancelOrderCommandHandlerTest
+{
+    private readonly IOrderRepository _orderRepositoryMock = Substitute.For<IOrderRepository>();
+    private readonly IBuyerRepository _buyerRepositoryMock = Substitute.For<IBuyerRepository>();
+
+    private Order ArrangeOrderOwnedBy(string ownerIdentity)
+    {
+        var order = new Order("owner", "fakeName", new Address("street", "city", "state", "country", "zip"),
+            5, "12", "123", "name", DateTime.UtcNow);
+        order.SetPaymentMethodVerified(7, 1);
+        _orderRepositoryMock.GetAsync(1).Returns(Task.FromResult(order));
+        _buyerRepositoryMock.FindByIdAsync(7).Returns(Task.FromResult(new Buyer(ownerIdentity, "owner")));
+        _orderRepositoryMock.UnitOfWork.SaveEntitiesAsync(default).ReturnsForAnyArgs(Task.FromResult(true));
+        return order;
+    }
+
+    [TestMethod]
+    public async Task Handle_does_not_cancel_order_owned_by_another_user()
+    {
+        var order = ArrangeOrderOwnedBy("owner");
+        var handler = new CancelOrderCommandHandler(_orderRepositoryMock, _buyerRepositoryMock);
+
+        var result = await handler.Handle(new CancelOrderCommand(1, "attacker"), default);
+
+        Assert.IsFalse(result);
+        Assert.AreNotEqual(OrderStatus.Cancelled, order.OrderStatus);
+    }
+
+    [TestMethod]
+    public async Task Handle_cancels_order_owned_by_caller()
+    {
+        var order = ArrangeOrderOwnedBy("owner");
+        var handler = new CancelOrderCommandHandler(_orderRepositoryMock, _buyerRepositoryMock);
+
+        var result = await handler.Handle(new CancelOrderCommand(1, "owner"), default);
+
+        Assert.IsTrue(result);
+        Assert.AreEqual(OrderStatus.Cancelled, order.OrderStatus);
+    }
+}

